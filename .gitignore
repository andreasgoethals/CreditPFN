# Private inputs, weights and historical runs (never commit).
/data/
/archive/
/src/data/_private_names.py
# preprocessing.py is intentionally tracked for cluster imports. Re-privatize
# its proprietary names out of band when the preprocessing code is frozen.
/checkpoints/*
!/checkpoints/.gitkeep
!/checkpoints/README.md
*.ckpt
*.pt
*.pth
*.bin
*.safetensors

# Canonical generated output, partitioned by experiment.
/output CreditPFN/
# Historical output remains ignored; current writers use the name above.
/output/
/results/
/logs/
/.sentinels/
/downloads/
*.log
slurm-*.out
slurm-*.err

# Environments, credentials and personal agent settings.
.env
.env.*
.envrc
.venv/
venv/
env/
ENV/
.pypirc
CLAUDE.local.md
/.claude/
/.codex/

# Python/build/test/tool caches.
__pycache__/
*.py[codz]
*.so
*.egg-info/
*.egg
.eggs/
build/
dist/
.Python
__pypackages__/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.uv-cache/
.cache/
.tox/
.nox/
.coverage*
coverage.xml
htmlcov/
.ipynb_checkpoints/
docs/_build/

# Optional experiment trackers must not leak separate output trees into Git.
wandb/
mlruns/
lightning_logs/
tb_logs/
tensorboard/
outputs/
multirun/

# Editors: share only the repository's import-path settings.
.idea/
/.vscode/*
!/.vscode/settings.json
*.swp
*.swo
.DS_Store
Thumbs.db

# Large artifact formats outside the designated trees.
*.parquet
*.feather
*.h5
*.hdf5
*.npz
*.npy
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.arrow
*.pkl
*.pickle
*.joblib
*.onnx
